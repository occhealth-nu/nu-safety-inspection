# ====== NU Safety Inspection — ตัวอย่างการตั้งค่า (ไม่มีค่าลับจริง) ======
# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# ใช้เฉพาะฝั่งเซิร์ฟเวอร์: สร้างบัญชีผู้ใช้ และงานแจ้งเตือน (ห้ามเปิดเผยใน browser)
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# URL ของระบบ (ใช้สร้าง QR Code และลิงก์ในอีเมล) — ต้องเป็น URL ถาวร
NEXT_PUBLIC_APP_URL=https://safety.example.ac.th

# ความลับสำหรับเรียก /api/cron/notifications — ใช้เฉพาะ a-z A-Z 0-9 ยาว 32–64 ตัว (ห้ามช่องว่าง/ภาษาไทย/สัญลักษณ์)
CRON_SECRET=replace-with-long-random-string

# อีเมลแจ้งเตือน (SMTP ของมหาวิทยาลัย) — เว้นว่างไว้ = ยังไม่ส่งอีเมล (แจ้งเตือนในระบบอย่างเดียว)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NU Safety Inspection <no-reply@example.ac.th>"

# เข้าสู่ระบบด้วยบัญชีมหาวิทยาลัย — ดู docs/GOOGLE_LOGIN.md
# google = บัญชี Google Workspace @nu.ac.th (แนะนำ) | azure | saml  — เว้นว่าง = อีเมล/รหัสผ่านอย่างเดียว
NEXT_PUBLIC_SSO_PROVIDER=
# โดเมนองค์กร (ค่าเริ่มต้นเมื่อใช้ google คือ nu.ac.th) — โดเมนที่ "อนุญาตจริง" ตั้งในระบบ: ตั้งค่าระบบ › ภาพลักษณ์และการเข้าสู่ระบบ
NEXT_PUBLIC_SSO_DOMAIN=
